# Copy this file to .env and fill in real values.
# main.py loads .env automatically via python-dotenv (see requirements.txt).
# Never commit the real .env file (already covered by .gitignore).

# ASU CreateAI service token (18 of the 20 test models, free/courtesy access).
# NO quotes around the value.
ASU_CREATEAI_TOKEN=

# DeepSeek direct API key (DeepSeek-V3 / DeepSeek-V4 -- not on ASU CreateAI).
DEEPSEEK_API_KEY=
